{
  "VERSION": "2026-10-13-v4.0.4-clef-guardrails",
  "files": {
    "cache": "cache_tavily.sqlite",
    "master": "Consolidado Base de Produtos Enriquecida.xlsx",
    "final": "Base Final Produtos Enriquecida.xlsx",
    "classification_db": "pipeline_v3.sqlite",
    "output": "Classificacao_v3.xlsx",
    "inventory_output": "Inventario_v3.xlsx",
    "input": "Base de Produtos.xlsx",
    "collection_report": "Coleta_Search_R9_6.xlsx",
    "precollection_report": "Pre_Coleta_R9_6.xlsx",
    "pending_with_cache": "Pendentes_Com_Cache.xlsx",
    "pending_without_cache": "Pendentes_Sem_Cache.xlsx",
    "baseline_backup_dir": "Backups_Baseline",
    "baseline_audit": "Auditoria_Baseline_R9_5.csv",
    "collection_policy": "collection_quality_policy.json",
    "collection_report_cache_rebuild": "Curadoria_Cache_R9_6.xlsx"
  },
  "evidence": {
    "max_results": 5,
    "content_chars": 2400
  },
  "identity": {
    "regional_suffixes": [
      "AR",
      "BR",
      "B1",
      "B2",
      "B3",
      "B4"
    ],
    "operational_suffixes_by_brand": {
      "INGCO": [
        "4"
      ],
      "TOTAL": [
        "4"
      ],
      "EMTOP": [
        "4"
      ],
      "WADFOW": [
        "4"
      ],
      "JADEVER": [
        "4"
      ],
      "SENSEI": [
        "4"
      ],
      "DONG CHENG": [
        "220V"
      ]
    },
    "embedded_sku_brands": [
      "MAKITA"
    ],
    "embedded_sku_min_length": 5,
    "short_model_requires_brand_length": 5,
    "revision_suffixes_by_brand": {
      "GREENWORKS": [
        "DA1",
        "A1",
        "A3"
      ]
    },
    "trailing_spec_suffix_regexes": [
      "^\\d+(?:[.,]\\d+)?V$",
      "^\\d+(?:[.,]\\d+)?VAC$",
      "^\\d+(?:[.,]\\d+)?VDC$",
      "^\\d+(?:[.,]\\d+)?HZ$"
    ],
    "max_trailing_spec_suffixes": 2,
    "normalize_search_model_separators": true,
    "trailing_operational_phrase_regexes": [
      "\\s+TYPE\\s+[A-Z0-9]{1,4}$"
    ],
    "auto_approval_requires_strong_identity": true,
    "strong_identity_requires_brand_in_primary_field": true
  },
  "recovery": {
    "reprocess_stale_auto_approved": true,
    "rule_metadata_source": "Consolidado",
    "hard_lock_review_bi_value": "OK"
  },
  "quality_gates": {
    "source": "regras_negocio.json",
    "fail_before_classification": true
  },
  "collection_quality": {
    "require_curated_evidence_for_classification": true
  },
  "collection": {
    "provider": "tavily",
    "query_template": "{brand} {search_model}",
    "hard_limits": {
      "max_requests_per_product": 1,
      "allow_automatic_retry": false,
      "allow_secondary_search": false,
      "allow_provider_failover": false,
      "allow_extract": false
    },
    "providers": {
      "tavily": {
        "base_url": "https://api.tavily.com/search",
        "api_key_env": "TAVILY_API_KEY",
        "requests_per_minute": 30,
        "timeout_seconds": 60,
        "search_depth": "basic",
        "max_results": 10,
        "chunks_per_source": 3,
        "include_raw_content": "text"
      },
      "serper": {
        "base_url": "https://google.serper.dev/search",
        "api_key_env": "SERPER_API_KEY",
        "requests_per_minute": 50,
        "timeout_seconds": 60,
        "max_results": 10
      },
      "brightdata": {
        "base_url": "https://api.brightdata.com/request",
        "api_key_env": "BRIGHTDATA_API_KEY",
        "zone_env": "BRIGHTDATA_ZONE",
        "zone": "",
        "requests_per_minute": 30,
        "timeout_seconds": 60,
        "max_results": 10,
        "data_format": "parsed_light",
        "format": "json"
      }
    },
    "local_enrichment": {
      "enabled": true,
      "max_urls_per_product": 2,
      "snippet_sufficient_chars": 220,
      "timeout_seconds": 12,
      "max_bytes": 1500000,
      "max_text_chars": 30000,
      "user_agent": "Mozilla/5.0 ProductEnricher/1.0",
      "engine": "trafilatura",
      "dynamic_browser_fallback": false
    }
  },
  "semantic_funnel": {
    "embedding_model": "C:\\p\\models\\bge-m3",
    "reranker_model": "C:\\p\\models\\bge-reranker-v2-m3",
    "embedding_device": "cpu",
    "reranker_device": "auto",
    "embedding_batch_size": 32,
    "rerank_batch_size": 8,
    "type_dense_k": 8,
    "type_pool_k": 10,
    "type_top_k": 6,
    "taxonomy_dense_k": 8,
    "taxonomy_pool_k": 10,
    "taxonomy_top_k": 6,
    "max_sources": 4,
    "source_chars": 420,
    "max_evidence_chars": 1800,
    "local_files_only": true,
    "offline_mode": true,
    "rerank_max_length": 192,
    "rerank_types": false,
    "rerank_taxonomy": true,
    "direct_stage1_threshold": 4
  },
  "clef": {
    "model": "clef",
    "account_id_env": "CLOUDFLARE_ACCOUNT_ID",
    "api_token_env": "CLOUDFLARE_API_TOKEN",
    "timeout_seconds": 90,
    "retry_attempts": 3,
    "retry_backoff_seconds": [
      2,
      5,
      10
    ],
    "operational_requests_per_minute": 10.0,
    "max_api_calls_per_run": 0,
    "max_total_tokens_per_run": 0,
    "auto_approval": {
      "require_strong_identity": true,
      "require_type_taxonomy_compatible": true,
      "min_taxonomy_probability": 0.7,
      "min_taxonomy_confidence": 0.5,
      "min_taxonomy_margin": 0.2,
      "min_type_probability": 0.55,
      "min_type_confidence": 0.25
    },
    "repair": {
      "enabled": true,
      "max_attempts": 1,
      "max_types": 5,
      "max_joint_options": 14
    }
  },
  "classification_flow": {
    "clef_required_after_non_rule": true,
    "preserve_valid_clef_classification_below_auto_gate": true,
    "no_automatic_secondary_search": true,
    "review_is_last_resort": true,
    "recovery_priority": [
      "READY_FOR_CLASSIFICATION",
      "PARTIAL_TARGET_EVIDENCE",
      "NO_TARGET_EVIDENCE"
    ],
    "weak_identity_requires_recollection": false,
    "repair_type_taxonomy_conflict": true,
    "max_clef_repair_attempts": 1
  }
}
